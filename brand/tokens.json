{
  "name": "Piercast",
  "tagline": "Launch anything. From anywhere.",
  "domains": {
    "primary": "piercast.io",
    "cli": "piercast.sh",
    "alt": "piercast.co",
    "optional": ["piercast.app", "piercast.dev", "usepiercast.com"],
    "avoid": ["piercast.com"],
    "purchase_status": "pending_manual_checkout"
  },
  "github": {
    "preferred_org": "piercast",
    "fallback_org": "piercast-hq",
    "current_remote": "https://github.com/lfernando2703/piercast.git",
    "note": "Migrate to piercast/piercast when org exists (needs admin:org)"
  },
  "colors": {
    "primary": "#7B6CFF",
    "ink": "#0B0B0F",
    "fog": "#F5F5F7",
    "success": "#30D158",
    "warn": "#FF9F0A",
    "danger": "#FF453A"
  },
  "typography": {
    "apple": "SF Pro",
    "web_linux": "Inter",
    "windows": "Segoe UI Variable"
  },
  "logo": {
    "mark": "minimal pier/pylon",
    "assets": "brand/logo/"
  },
  "bundle_ids": {
    "ios": "io.piercast.app",
    "android": "io.piercast.android"
  },
  "control_plane": {
    "http": "http://127.0.0.1:47923",
    "port_env": "PIERCAST_PORT"
  }
}
