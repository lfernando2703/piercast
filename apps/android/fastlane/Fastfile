default_platform(:android)

platform :android do
  desc "Assemble release APK (internal)"
  lane :apk do
    gradle(task: "assembleRelease", project_dir: "apps/android")
  end

  desc "Bundle for Play Store when credentials present"
  lane :bundle do
    # gradle(task: "bundleRelease")
    UI.message("Manual: ./gradlew :app:bundleRelease when keystore configured")
  end
end
